# Local Ollama defaults; install qwen2.5:3b and the Chinese embedding model.
CARWISE_LLM_PROVIDER=ollama
CARWISE_OLLAMA_BASE_URL=http://127.0.0.1:11434
CARWISE_OLLAMA_CHAT_MODEL=qwen2.5:3b
CARWISE_OLLAMA_EMBED_MODEL=quentinz/bge-small-zh-v1.5

# Optional alternative for generated answers. Never commit a real key.
# CARWISE_LLM_PROVIDER=deepseek
# CARWISE_DEEPSEEK_API_KEY=
# CARWISE_DEEPSEEK_MODEL=deepseek-chat

